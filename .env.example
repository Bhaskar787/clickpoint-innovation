# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connect via transaction pooler (port 6543) for serverless Vercel runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect via session pooler or direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# AUTH & ADMIN CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_SECRET="your-strong-random-session-secret"
ADMIN_EMAIL="info@clickpoint.com.np"
ADMIN_PASSWORD="your-strong-admin-password"
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# ------------------------------------------------------------------------------
# PRODUCTION AI CHATBOT (Google Gemini LLM)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL_NAME="gemini-1.5-flash"

# Optional Microservice / Internal Key
INTERNAL_API_KEY="clickpoint-secret-internal-key-2026"
CHAT_SERVICE_URL=""
REDIS_URL=""

# ------------------------------------------------------------------------------
# CLOUDINARY (Media & Portfolio Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# SMTP / EMAIL NOTIFICATIONS (Nodemailer)
# ------------------------------------------------------------------------------
COMPANY_HR_EMAIL="hr@yourcompany.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Clickpoint Innovations" <your-email@gmail.com>'